{
  "name": "@cardapio/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "iniciar": "node --import ./src/instrumentacao.ts src/principal.ts",
    "build": "tsc -p tsconfig.build.json && sentry-cli sourcemaps inject dist",
    "tipos": "tsc --noEmit -p .",
    "iniciar:dist": "node --import ./dist/instrumentacao.js dist/principal.js"
  },
  "dependencies": {
    "@cardapio/aplicacao": "workspace:*",
    "@cardapio/config": "workspace:*",
    "@cardapio/infraestrutura": "workspace:*",
    "@cardapio/observabilidade": "workspace:*",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  }
}
