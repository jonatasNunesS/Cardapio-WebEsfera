# Modelo das variáveis de ambiente. Copie para .env (não versionado).
# Os valores abaixo servem só para o docker compose local; nenhum é real.

# Modo do Node: development, test ou production.
NODE_ENV=development

# Ambiente da aplicação: local, preview, homologacao ou producao.
APP_ENV=local

# Porta HTTP em que a API escuta.
PORTA_API=3000

# Conexão do PostgreSQL usada pela API (papel da aplicação, nunca o das migrações).
URL_BANCO=postgres://cardapio:cardapio_local@postgres:5432/cardapio

# Conexão do Redis (cache, filas e pub/sub).
URL_REDIS=redis://redis:6379

# Domínio público do cardápio do cliente (ver docs/adr/0003-dominios-e-ambientes.md).
DOMINIO_CARDAPIO=cardapio.localhost

# Domínio público do painel do restaurante.
DOMINIO_PAINEL=painel.localhost

# Domínio público do admin da plataforma.
DOMINIO_ADMIN=admin.localhost

# Domínio público da API.
DOMINIO_API=api.localhost

# Commit da build; entra na release do Sentry (<app>@<versao>+<sha curto>). Vazio vira "local".
COMMIT_SHA=

# DSN do projeto cardapio-backend no Sentry (api e worker). Vazio desliga o Sentry.
SENTRY_DSN_BACKEND=

# DSN do projeto cardapio-frontend no Sentry (cardapio, painel e admin), lido no build.
SENTRY_DSN_FRONTEND=

# Amostragem de traces de 0 a 1. Vazio: 1.0 em local e preview, 0.1 em homologacao e producao.
SENTRY_AMOSTRAGEM_TRACES=

# Organização e projetos no Sentry, usados só no envio de source maps pelo CI.
SENTRY_ORG=
SENTRY_PROJETO_BACKEND=
SENTRY_PROJETO_FRONTEND=

# O SENTRY_AUTH_TOKEN existe só nos segredos do CI. Nunca neste arquivo nem no .env.
