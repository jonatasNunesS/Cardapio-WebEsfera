# Modelo das variáveis de ambiente. Copie para .env (não versionado).
# Os valores abaixo servem só para o docker compose local; nenhum é real.

# Modo do Node: development, test ou production.
NODE_ENV=development

# Ambiente da aplicação: local, preview, homologacao ou producao.
APP_ENV=local

# Porta HTTP em que a API escuta.
PORTA_API=3000

# Senhas dos usuários de login do PostgreSQL, usadas só pelo script de
# inicialização do compose (banco/inicializacao). Em produção, ver docs/runbooks/banco.md.
SENHA_BANCO_MIGRACAO=migracao_local
SENHA_BANCO_API=api_local
SENHA_BANCO_WORKER=worker_local

# Conexão da API: usuário cardapio_api, membro de app_runtime.
URL_BANCO_API=postgres://cardapio_api:api_local@postgres:5432/cardapio

# Conexão do worker: usuário cardapio_worker, membro de app_runtime e app_sistema.
URL_BANCO_WORKER=postgres://cardapio_worker:worker_local@postgres:5432/cardapio

# Conexão das migrações (pnpm banco:migrar): usuário cardapio_migracao. Nunca usada pela aplicação.
# Fora do compose, troque o host por 127.0.0.1.
URL_BANCO_MIGRACAO=postgres://cardapio_migracao:migracao_local@postgres:5432/cardapio

# Conexão do Redis (cache, filas e pub/sub).
URL_REDIS=redis://redis:6379

# Domínio público do cardápio do cliente (ver docs/adr/0003-dominios-e-ambientes.md).
DOMINIO_CARDAPIO=cardapio.localhost

# Domínio público do painel do restaurante.
DOMINIO_PAINEL=painel.localhost

# Domínio público do admin da plataforma.
DOMINIO_ADMIN=admin.localhost

# A API não tem domínio próprio: cada app chama /api no próprio host, atrás de
# um proxy reverso (local: proxy do Vite). Ver docs/adr/0003-dominios-e-ambientes.md.

# Endereço do painel usado nos links dos e-mails (redefinição de senha).
URL_PAINEL=http://painel.localhost:5173

# Para onde o servidor de desenvolvimento do Vite encaminha /api (só em local).
URL_API_LOCAL=http://127.0.0.1:3000

# Chave AES-256 (32 bytes em base64) que cifra o segredo TOTP dos admins.
# Gere uma por ambiente: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# Trocar a chave invalida os segredos já cadastrados (ver docs/adr/0008-identidade-e-sessoes.md).
CHAVE_CIFRA_TOTP=48rzXBRCeMX1spnFQaKnsh8aRrCWV+dH/Ce7v7Ujqz0=

# Chave HMAC (32 caracteres ou mais) que assina o cookie da sessão de mesa.
# Gere uma por ambiente: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# Trocar a chave encerra as sessões de mesa abertas (ver docs/adr/0012-mesas-e-qr.md).
CHAVE_SESSAO_MESA=mesa-local-mesa-local-mesa-local-mesa

# Proxies confiáveis para ler o IP do cliente (X-Forwarded-For), em CIDR separados
# por vírgula. Vazio: nenhum (usa o IP da conexão).
PROXIES_CONFIAVEIS=

# Commit da build; entra na release do Sentry (<app>@<versao>+<sha curto>). Vazio vira "local".
COMMIT_SHA=

# DSN do projeto cardapio-backend no Sentry (api e worker). Vazio desliga o Sentry.
SENTRY_DSN_BACKEND=

# DSN do projeto cardapio-frontend no Sentry (cardapio, painel e admin), lido no build.
SENTRY_DSN_FRONTEND=

# Amostragem de traces de 0 a 1. Vazio: 1.0 em local e preview, 0.1 em homologacao e producao.
SENTRY_AMOSTRAGEM_TRACES=

# Organização e projetos no Sentry, usados só no envio de source maps pelo CI.
SENTRY_ORG=
SENTRY_PROJETO_BACKEND=
SENTRY_PROJETO_FRONTEND=

# O SENTRY_AUTH_TOKEN existe só nos segredos do CI. Nunca neste arquivo nem no .env.

# Armazenamento de mídia, compatível com S3 (ver docs/adr/0011-midia-e-video.md).
# Local: Garage do compose. Produção: Cloudflare R2 (https://<conta>.r2.cloudflarestorage.com, região auto).
URL_ARMAZENAMENTO=http://garage:3900
# Endereço que o navegador usa para o envio direto (a URL assinada leva este host). Vazio: igual ao de cima.
URL_ENVIO_ARMAZENAMENTO=http://127.0.0.1:3900
REGIAO_ARMAZENAMENTO=garage
CHAVE_ARMAZENAMENTO=GKabababababababababababab
SEGREDO_ARMAZENAMENTO=cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd
# Bucket privado dos originais e bucket público dos derivados.
BUCKET_ORIGINAIS=midia-originais
BUCKET_PUBLICO=midia-publica
# Endereço público dos derivados (em produção, o domínio próprio ligado ao bucket público).
URL_PUBLICA_MIDIA=http://midia-publica.web.localhost:3902

# Mercado Pago (ver docs/adr/0014-assinaturas-e-cobranca.md e docs/runbooks/pagamentos.md).
# Endereço da API. Vazio: https://api.mercadopago.com. Outro valor só com APP_ENV=local
# (o Mercado Pago falso: pnpm mp:falso, em http://127.0.0.1:3999).
URL_MERCADO_PAGO=http://127.0.0.1:3999
# Access token da aplicação (API e worker). Um por ambiente, nunca no repositório.
MP_ACCESS_TOKEN=TEST-local-mercado-pago-falso
# Assinatura secreta das notificações (API). Um por ambiente, nunca no repositório.
MP_WEBHOOK_SECRET=segredo-local-do-webhook-falso
# Só para o Mercado Pago falso: para onde ele manda os avisos assinados.
URL_AVISO_FALSO=http://127.0.0.1:3000/api/v1/webhooks/mercado-pago
