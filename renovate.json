{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":semanticCommits"],
  "timezone": "America/Sao_Paulo",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "pin",
  "labels": ["dependencias"],
  "packageRules": [
    {
      "description": "TypeScript fica na linha 6 enquanto o typescript-eslint exigir < 6.1 (ADR 0001).",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    },
    {
      "description": "Node fica na linha 24 até a migração planejada para o 26 (ADR 0001).",
      "matchPackageNames": ["node", "@types/node"],
      "allowedVersions": "<25"
    },
    {
      "description": "Atualizações de patch e minor das ferramentas de desenvolvimento num único PR.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "ferramentas de desenvolvimento"
    }
  ]
}
