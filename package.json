{
  "name": "cardapio-webesfera",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "verificar": "pnpm verificar:emoji && pnpm lint && pnpm tipos && pnpm testes",
    "verificar:emoji": "node scripts/verificar-emoji.ts",
    "banco:migrar": "node --env-file-if-exists=.env scripts/banco-migrar.ts",
    "armazenamento:preparar": "node --env-file-if-exists=.env scripts/armazenamento-preparar.ts",
    "admin:criar": "node --env-file-if-exists=.env scripts/admin-criar.ts",
    "lint": "eslint . --max-warnings 0 && stylelint \"**/*.css\" --max-warnings 0 && prettier --check .",
    "formatar": "prettier --write .",
    "tipos": "tsc --noEmit -p . && pnpm -r --workspace-concurrency=1 run tipos",
    "testes": "vitest run",
    "build": "pnpm -r run build && node scripts/verificar-bundle-web.ts",
    "ciclos": "madge --circular --extensions ts,tsx --exclude \"(node_modules|dist)/\" apps pacotes scripts",
    "duplicacao": "jscpd",
    "auditoria": "pnpm audit --audit-level high",
    "storybook": "pnpm --filter @cardapio/ui storybook",
    "storybook:build": "pnpm --filter @cardapio/ui storybook:build",
    "e2e": "playwright test -c scripts/e2e/playwright.config.ts",
    "visual": "node scripts/testes-visuais.ts",
    "visual:atualizar": "node scripts/testes-visuais.ts --atualizar"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@eslint-react/eslint-plugin": "5.28.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sentry/cli": "3.8.0",
    "@storybook/addon-vitest": "10.6.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@typescript-eslint/utils": "8.72.0",
    "@vitest/browser-playwright": "5.0.5",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "jscpd": "5.4.1",
    "jsdom": "30.1.3",
    "madge": "8.0.0",
    "otplib": "13.5.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.3",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
